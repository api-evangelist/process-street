{
  "opencollection": "1.0.0",
  "info": {
    "name": "Process Street Public Attachments Scheduled Workflows API",
    "version": "1.1"
  },
  "items": [
    {
      "info": {
        "name": "Scheduled Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List scheduled workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.process.st/api/v1.1/scheduled-workflows",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "query",
                "description": "Filter by workflow."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Case-insensitive substring match on name."
              },
              {
                "name": "_",
                "value": "",
                "type": "query",
                "description": "Opaque pagination cursor. Take this value from the previous response's `links[]` entry whose `name`\nis `\"next\"` (typically just follow that link's `href` instead of reading this value).\nOmit on the first page. If the previous response had no `next` link, there are no more pages."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a paginated list of scheduled workflows, ordered by next run date."
        },
        {
          "info": {
            "name": "Create a scheduled workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public-api.process.st/api/v1.1/scheduled-workflows",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a scheduled workflow that runs a workflow on a recurring schedule."
        },
        {
          "info": {
            "name": "Get a scheduled workflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.process.st/api/v1.1/scheduled-workflows/:scheduledWorkflowId",
            "params": [
              {
                "name": "scheduledWorkflowId",
                "value": "",
                "type": "path",
                "description": "The ID of the scheduled workflow."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a scheduled workflow by its ID."
        },
        {
          "info": {
            "name": "Update a scheduled workflow",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://public-api.process.st/api/v1.1/scheduled-workflows/:scheduledWorkflowId",
            "params": [
              {
                "name": "scheduledWorkflowId",
                "value": "",
                "type": "path",
                "description": "The ID of the scheduled workflow."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Updates a scheduled workflow. PUT semantics: all mutable fields must be provided. Rules and assignees are fully replaced."
        },
        {
          "info": {
            "name": "Delete a scheduled workflow",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://public-api.process.st/api/v1.1/scheduled-workflows/:scheduledWorkflowId",
            "params": [
              {
                "name": "scheduledWorkflowId",
                "value": "",
                "type": "path",
                "description": "The ID of the scheduled workflow."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Deletes a scheduled workflow and unschedules all future runs."
        }
      ]
    }
  ],
  "bundled": true
}