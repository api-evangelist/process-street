  "item": [
    {
      "id": "837ff5b8-8a5a-4255-9ee1-5d44590c8e00",
      "name": "Workflow Task Assignment Rules",
      "description": {
        "content": "A workflow task assignment rule assigns a task template on a draft workflow\nrevision to a specific user (static) or derives assignees from a source such\nas the workflow run initiator, a Members form field, or the source document's\nowner/author (dynamic). Use these endpoints to replace the full set of\nassignment rules on a task template.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f58fe19d-ca0e-4149-8867-aa7cb437d638",
          "name": "Get task assignment rules",
          "request": {
            "name": "Get task assignment rules",
            "description": {
              "content": "Returns the assignment rules for a task on a workflow revision. Each rule has a `type` discriminator: `Static` includes the assignee's `email`; `Dynamic` includes a `sourceType` (one of `ChecklistInitiator`, `FormField`, `DocumentOwner`, `DocumentAuthor`), and when `sourceType` is `FormField`, also a `sourceWidgetId` pointing to a Members or Email form field widget in the same revision.",
              "type": "text/plain"
            },
            "url": {
