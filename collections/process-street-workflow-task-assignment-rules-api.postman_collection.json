        {
          "id": "40764a9d-ce6d-4143-96ab-9096aed6ac93",
          "name": "Update task assignment rules",
          "request": {
            "name": "Update task assignment rules",
            "description": {
              "content": "Replaces the assignment rules for a task on a draft workflow revision. PUT semantics: send the full list of desired rules to replace all existing ones; send an empty array to remove all assignments. Each rule has a `type` discriminator: `Static` requires an `email`; `Dynamic` requires a `sourceType` (one of `ChecklistInitiator`, `FormField`, `DocumentOwner`, `DocumentAuthor`), and when `sourceType` is `FormField`, also a `sourceWidgetId` pointing to a Members or Email form field widget in the same revision. Returns the resulting assignment rules.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "workflows",
                ":workflowId",
                "revisions",
                ":revisionId",
                "tasks",
                ":taskId",
                "assignment-rules"
              ],
