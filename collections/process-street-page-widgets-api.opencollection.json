{
  "opencollection": "1.0.0",
  "info": {
    "name": "Process Street Public Attachments Page Widgets API",
    "version": "1.1"
  },
  "items": [
    {
      "info": {
        "name": "Page Widgets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a page widget",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.process.st/api/v1.1/pages/:pageId/revisions/:revisionId/widgets/:widgetId",
            "params": [
              {
                "name": "pageId",
                "value": "",
                "type": "path",
                "description": "The ID of the Page"
              },
              {
                "name": "revisionId",
                "value": "",
                "type": "path",
                "description": "The ID of the Revision"
              },
              {
                "name": "widgetId",
                "value": "",
                "type": "path",
                "description": "The ID of the Widget"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a widget by its ID on a page revision."
        },
        {
          "info": {
            "name": "Update a page widget",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://public-api.process.st/api/v1.1/pages/:pageId/revisions/:revisionId/widgets/:widgetId",
            "params": [
              {
                "name": "pageId",
                "value": "",
                "type": "path",
                "description": "The ID of the Page"
              },
              {
                "name": "revisionId",
                "value": "",
                "type": "path",
                "description": "The ID of the Revision"
              },
              {
                "name": "widgetId",
                "value": "",
                "type": "path",
                "description": "The ID of the Widget"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Updates a widget on a draft page revision. PUT semantics: all mutable fields must be provided.\nReturns the updated widget."
        },
        {
          "info": {
            "name": "Delete a page widget",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://public-api.process.st/api/v1.1/pages/:pageId/revisions/:revisionId/widgets/:widgetId",
            "params": [
              {
                "name": "pageId",
                "value": "",
                "type": "path",
                "description": "The ID of the Page"
              },
              {
                "name": "revisionId",
                "value": "",
                "type": "path",
                "description": "The ID of the Revision"
              },
              {
                "name": "widgetId",
                "value": "",
                "type": "path",
                "description": "The ID of the Widget"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Deletes a widget from a draft page revision."
        },
        {
          "info": {
            "name": "List page widgets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.process.st/api/v1.1/pages/:pageId/revisions/:revisionId/widgets",
            "params": [
              {
                "name": "pageId",
                "value": "",
                "type": "path",
                "description": "The ID of the Page"
              },
              {
                "name": "revisionId",
                "value": "",
                "type": "path",
                "description": "The ID of the Revision"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by widget type."
              },
              {
                "name": "_",
                "value": "",
                "type": "query",
                "description": "Opaque pagination cursor. Take this value from the previous response's `links[]` entry whose `name`\nis `\"next\"` (typically just follow that link's `href` instead of reading this value).\nOmit on the first page. If the previous response had no `next` link, there are no more pages."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns widgets on a page revision, ordered by position."
        },
        {
          "info": {
            "name": "Create a page widget",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public-api.process.st/api/v1.1/pages/:pageId/revisions/:revisionId/widgets",
            "params": [
              {
                "name": "pageId",
                "value": "",
                "type": "path",
                "description": "The ID of the Page"
              },
              {
                "name": "revisionId",
                "value": "",
                "type": "path",
                "description": "The ID of the Revision"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a widget on a draft page revision."
        },
        {
          "info": {
            "name": "Upload a file to a page widget",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public-api.process.st/api/v1.1/pages/:pageId/revisions/:revisionId/widgets/:widgetId/upload",
            "params": [
              {
                "name": "pageId",
                "value": "",
                "type": "path",
                "description": "The ID of the Page"
              },
              {
                "name": "revisionId",
                "value": "",
                "type": "path",
                "description": "The ID of the Revision"
              },
              {
                "name": "widgetId",
                "value": "",
                "type": "path",
                "description": "The ID of the Widget"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Uploads a file to an Image or File widget on a draft page revision. Replaces the existing file, if any.\n\nAccepts multipart form data (field `file`) or JSON with base64-encoded content (field `fileBase64`).\nMaximum file size: 20 MB for multipart, 10 MB for base64.\nYou can also send JSON `{ \"fileUploadId\": \"...\" }` to attach a file you uploaded with\n`createFileUpload`; the `fileUploadId` is single-use.\nFor Image widgets, only image/* content types are accepted."
        }
      ]
    }
  ],
  "bundled": true
}