        {
          "id": "5a1d4d22-c55b-4366-82b8-3f4a41728b9d",
          "name": "Create an incoming webhook for a data set",
          "request": {
            "name": "Create an incoming webhook for a data set",
            "description": {
              "content": "Creates an incoming webhook for a data set. When the webhook URL receives a JSON payload,\nit creates or updates data set rows using the configured column mappings.\n\n**config.columns** maps data set column IDs to JSON path expressions in the incoming payload.\nEach key is a column ID (Muid), each value is a JSON path (e.g. `$.contact.email`).\n\n**config.keyColumn** (optional) specifies a column used as a unique key for upserts.\nWhen set, incoming payloads update existing rows matching the key value.\nWhen absent, every payload creates a new row.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data-sets",
                ":dataSetId",
                "incoming-webhooks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
