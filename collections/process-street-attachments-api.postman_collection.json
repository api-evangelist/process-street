          "id": "f12ee759-f7de-4bab-bd33-a214b1f87a5a",
          "name": "Upload an attachment",
          "request": {
            "name": "Upload an attachment",
            "description": {
              "content": "Uploads a file as a task-level attachment.\n\nRequires `workflowRunId` and `taskId` to identify the target task.\nAccepts multipart form data (fields `workflowRunId` + `taskId` + `file`) or JSON with base64-encoded content\n(fields `workflowRunId` + `taskId` + `fileBase64`). Maximum file size: 20 MB for multipart, 10 MB for base64.\nYou can also send `workflowRunId` + `taskId` + `fileUploadId` to attach a file you uploaded with\n`createFileUpload`; the `fileUploadId` is single-use.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "attachments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
