                  "key": "workflowRunId",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The ID of the Workflow Run."
                },
                {
                  "key": "taskId",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The ID of the Task."
                },
                {
                  "key": "file",
                  "type": "file",
                  "description": "Uploaded file reference. Use the upload endpoint to attach content."
                },
                {
                  "key": "fileBase64",
                  "value": "{\"content\":\"<string>\",\"filename\":\"<string>\"}",
