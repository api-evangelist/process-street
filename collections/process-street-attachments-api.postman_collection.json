    {
      "id": "f145732c-15cc-4585-b330-b229d8d1a200",
      "name": "Attachments",
      "description": {
        "content": "An attachment is a file uploaded to a task within a workflow run.\nUse these endpoints to list, upload, and delete task-level attachments.",
        "type": "text/plain"
      },
