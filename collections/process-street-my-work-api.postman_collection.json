{
  "item": [
    {
      "id": "d31a0f97-200a-46e4-a6f0-79fdccb2e39a",
      "name": "My Work",
      "description": {
        "content": "My Work is your personal task inbox — a consolidated view of all tasks and checklist items\nassigned to you across all workflows. Use these endpoints to list, search, and manage\nyour assigned work items.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2d6f8119-cb20-48b7-a91b-241bc90ab38d",
          "name": "List My Work items",
          "request": {
            "name": "List My Work items",
            "description": {
              "content": "Returns a paginated list of work items assigned to the authenticated user.\nUse `assigneeEmail` to filter by a specific user, or omit to default to the authenticated user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "work",
                "items"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "assigneeEmail",
                  "value": "<string>",
                  "description": "Filter by assignee email. Defaults to the authenticated user."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by item type.\n\n- `Checklist` — a workflow run assigned to the user.\n- `StandardTask` — a regular task within a workflow run.\n- `ApprovalTask` — an approval task awaiting the user's review.\n- `OneOffTask` — a standalone one-off task.\n- `Acknowledgment` — a revision-acknowledgment request after a workflow update.\n"
                },
                {
                  "disabled": false,
                  "key": "workflowId",
                  "value": "<string>",
                  "description": "Filter to a specific workflow. If the workflow does not exist or is inaccessible, the response is an empty page rather than an error."
                },
                {
                  "disabled": false,
                  "key": "dueDateFrom",
                  "value": "<string>",
                  "description": "Due date range start (ISO-8601, e.g. 2024-01-15)."
                },
                {
                  "disabled": false,
                  "key": "dueDateTo",
                  "value": "<string>",
                  "description": "Due date range end (ISO-8601, e.g. 2024-01-31)."
                },
                {
                  "disabled": false,
                  "key": "snoozeStatus",
                  "value": "<string>",
                  "description": "Filter by snooze status.\n\n- `Active` — non-snoozed items only.\n- `Snoozed` — items currently snoozed.\n\nOmit this filter to include both.\n"
                },
                {
                  "disabled": false,
                  "key": "includeCompleted",
                  "value": "<boolean>",
                  "description": "Include completed items. Defaults to false."
                },
                {
                  "disabled": false,
                  "key": "_",
                  "value": "<string>",
                  "description": "Opaque pagination cursor. Take this value from the previous response's `links[]` entry whose `name`\nis `\"next\"` (typically just follow that link's `href` instead of reading this value).\nOmit on the first page. If the previous response had no `next` link, there are no more pages."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
