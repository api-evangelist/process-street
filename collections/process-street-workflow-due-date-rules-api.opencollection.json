{
  "opencollection": "1.0.0",
  "info": {
    "name": "Process Street Public Attachments Workflow Due Date Rules API",
    "version": "1.1"
  },
  "items": [
    {
      "info": {
        "name": "Workflow Due Date Rules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the checklist due date rule",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.process.st/api/v1.1/workflows/:workflowId/revisions/:revisionId/due-date-rule",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "The ID of the Workflow"
              },
              {
                "name": "revisionId",
                "value": "",
                "type": "path",
                "description": "The ID of the Revision"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns the checklist-level due date rule for a workflow revision. The `rule` field is `null` when no rule is set."
        },
        {
          "info": {
            "name": "Set the checklist due date rule",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://public-api.process.st/api/v1.1/workflows/:workflowId/revisions/:revisionId/due-date-rule",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "The ID of the Workflow"
              },
              {
                "name": "revisionId",
                "value": "",
                "type": "path",
                "description": "The ID of the Revision"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Sets the single checklist-level due date rule on a draft workflow revision, replacing any existing rule. Send `rule: null` (or omit the field) to clear the existing rule. When `sourceType` is `FormFieldValue`, `sourceWidgetId` must reference a Date form field widget in the same revision. Returns the resulting rule."
        }
      ]
    }
  ],
  "bundled": true
}