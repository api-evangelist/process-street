{
  "opencollection": "1.0.0",
  "info": {
    "name": "Process Street Public Attachments Workflow Incoming Webhooks API",
    "version": "1.1"
  },
  "items": [
    {
      "info": {
        "name": "Workflow Incoming Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List incoming webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.process.st/api/v1.1/workflows/:workflowId/incoming-webhooks",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "The ID of the Workflow"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns all non-deleted incoming webhooks for a workflow, including disabled ones."
        },
        {
          "info": {
            "name": "Create an incoming webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public-api.process.st/api/v1.1/workflows/:workflowId/incoming-webhooks",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "The ID of the Workflow"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Creates an incoming webhook for a workflow. When the webhook URL receives a JSON payload,\nit creates a workflow run and populates it using the configured mappings.\n\n**config.properties** maps workflow run properties to JSON paths in the incoming payload:\n- `Name` — run name (string)\n- `DueDate` — due date (ISO 8601 date string)\n- `Shared` — whether the run is shared (boolean)\n- `Assignees` — assignee email addresses (string or array of strings)\n- `Runner` — runner email address (string)\n\n**confi"
        },
        {
          "info": {
            "name": "Get an incoming webhook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.process.st/api/v1.1/workflows/:workflowId/incoming-webhooks/:webhookId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "The ID of the Workflow"
              },
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "The ID of the Webhook"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns an incoming webhook by its ID for a workflow."
        },
        {
          "info": {
            "name": "Update an incoming webhook",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://public-api.process.st/api/v1.1/workflows/:workflowId/incoming-webhooks/:webhookId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "The ID of the Workflow"
              },
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "The ID of the Webhook"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Updates an incoming webhook for a workflow. PUT semantics: all fields must be provided. Returns the updated webhook.\n\nSee the create endpoint for details on `config.properties` and `config.formFields`."
        },
        {
          "info": {
            "name": "Delete an incoming webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://public-api.process.st/api/v1.1/workflows/:workflowId/incoming-webhooks/:webhookId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "The ID of the Workflow"
              },
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "The ID of the Webhook"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Soft-deletes an incoming webhook for a workflow. Subsequent GET requests will return 404."
        }
      ]
    }
  ],
  "bundled": true
}